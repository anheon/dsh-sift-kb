{
  "name": "dsh-sift-kb",
  "version": "1.3.5",
  "type": "module",
  "description": "DeepSeek Harness plugin that wires in the local sift knowledge base: opt-in server lifecycle, a sidebar panel, courseware import, and agent guidance.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/config.test.mjs test/mcp.test.mjs test/routes.test.mjs test/imports.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sift",
    "knowledge-base",
    "rag",
    "mcp"
  ],
  "license": "MIT",
  "author": "anheon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anheon/dsh-sift-kb.git"
  },
  "homepage": "https://github.com/anheon/dsh-sift-kb#readme",
  "bugs": {
    "url": "https://github.com/anheon/dsh-sift-kb/issues"
  },
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
